# Copier en `.env.local` (ignoré par Git) pour les essais Supabase en local.
# Ne jamais commiter de vraies valeurs.

# Projet Supabase : URL et clé publique « anon » uniquement (protégée par les règles RLS).
# Phase 1 : utilisées seulement par `npm run supabase:parity` ; le menu public reste sur la source statique.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# INTERDIT : la clé service_role ne doit jamais apparaître dans une variable VITE_* ni dans le frontend.
